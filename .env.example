# Captain Whiskers V2 — copy to .env at repo root (never commit .env)

# If `kraken` is installed but backend cannot find it, prepend PATH (e.g. PATH=/Users/you/.cargo/bin:$PATH)
# PATH=

# Kraken CLI (live trading only; paper works without keys)
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Gemini (defaults work for current API; override if your project uses different IDs)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro

# PRISM API (https://prismapi.ai)
PRISM_API_KEY=

# Base Sepolia
# Canonical variable for this repo (backend + Hardhat). Optional alias: BASE_SEPOLIA_RPC_URL (backend resolves it in rpc.util).
BASE_SEPOLIA_RPC=https://sepolia.base.org
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Alchemy dashboard → Base Sepolia app → API key (trial works). Overrides default only when BASE_SEPOLIA_RPC is empty.
ALCHEMY_API_KEY=
BASE_SEPOLIA_CHAIN_ID=84532
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
# Hex only: 0x + 64 hex chars (Ethereum wallet). Not Kraken API secret / Base64.
AGENT_PRIVATE_KEY=
AGENT_ADDRESS=

# Database (Vercel: USE_POSTGRES=true + hosted DATABASE_URL required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/captain_whiskers_v2
USE_POSTGRES=false

# App
NODE_ENV=development
PORT=3001
BACKEND_PORT=3001
# Comma-separated origins for CORS (required on Vercel for your Next.js URL)
FRONTEND_URL=http://localhost:3000
# On Vercel previews: allow any *.vercel.app (optional; less strict)
# ALLOW_VERCEL_PREVIEW_ORIGINS=true
JWT_SECRET=captain-whiskers-v2-jwt-secret

# Autonomous loop (optional)
TRADING_LOOP_ENABLED=false
TRADING_LOOP_INIT_PAPER=true
# Vercel Cron: set in Vercel project env; sent as Authorization: Bearer <secret>
# CRON_SECRET=

# Deployed contracts (fill after deploy)
RISK_ROUTER_ADDRESS=
CAPITAL_VAULT_ADDRESS=
MOCK_USDC_ADDRESS=
MOCK_WETH_ADDRESS=

# Hackathon Capital Sandbox (Base Sepolia — validateIntent / recordTradeExecution ABI only)
HACKATHON_CAPITAL_VAULT=
BASE_CAPITAL_SANDBOX_ROUTER=
# Legacy alias for Base sandbox router only (not Sepolia leaderboard address)
HACKATHON_LEGACY_BASE_ROUTER=

# Sepolia (11155111) hackathon leaderboard — HackathonModule + npm run register:hackathon
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
HACKATHON_AGENT_ID=
HACKATHON_AGENT_WALLET=

# Deprecated for RiskService: Sepolia leaderboard uses HackathonService. Do not set leaderboard router here.
# HACKATHON_RISK_ROUTER=

# ERC-8004 (Base Sepolia) — run: cd contracts && npm run verify:erc8004-registry
ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713
# Set after register (for npm run post:reputation, set:agent-uri)
ERC8004_AGENT_ID=
# Public agent card (Pinata or raw GitHub)
AGENT_CARD_URI=https://raw.githubusercontent.com/pbathuri/LABLAB-Hackathon/main/docs/agent-card.json

# Pinata (optional: npm run upload:agent-card in contracts/)
PINATA_JWT=

# Aerodrome (Base / Sepolia reference addresses)
AERODROME_ROUTER=0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874E43
AERODROME_FACTORY=0x420DD381b31aEf6683db6B902084cB0FFECe40Da
WETH_BASE=0x4200000000000000000000000000000000000006

# Quantum service
QUANTUM_SERVICE_URL=http://localhost:8000

# Frontend (next.config loads repo-root .env; optional apps/frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_QUANTUM_API_URL=http://localhost:8000
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
