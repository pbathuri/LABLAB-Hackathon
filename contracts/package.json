{
  "name": "@captain-whiskers/contracts",
  "version": "1.0.0",
  "description": "Captain Whiskers smart contracts (Base Sepolia, ERC-8004)",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network arc-testnet",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network arc-mainnet",
    "deploy:base-sepolia": "hardhat run scripts/deploy-base-sepolia.ts --network base-sepolia",
    "register:erc8004": "ts-node --transpile-only scripts/register-erc8004.ts",
    "verify:erc8004-registry": "ts-node --transpile-only scripts/verify-erc8004-registry.ts",
    "post:reputation": "ts-node --transpile-only scripts/post-reputation.ts",
    "set:agent-uri": "ts-node --transpile-only scripts/set-agent-uri.ts",
    "submit:hackathon-intent": "ts-node --transpile-only scripts/submit-hackathon-intent.ts",
    "register:hackathon": "ts-node --transpile-only scripts/register-hackathon.ts",
    "blast:intents": "ts-node --transpile-only scripts/blast-intents.ts",
    "upload:agent-card": "ts-node --transpile-only scripts/upload-agent-card.ts",
    "verify": "hardhat verify"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@openzeppelin/contracts": "^5.0.0",
    "@types/node": "^20.10.0",
    "dotenv": "^17.2.3",
    "hardhat": "^2.19.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}