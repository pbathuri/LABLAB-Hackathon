{
  "name": "captain-whiskers",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/frontend",
    "apps/quantum-service",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:frontend": "npm run dev -w @captain-whiskers/frontend",
    "dev:frontend:clean": "npm run dev:clean -w @captain-whiskers/frontend",
    "dev:frontend:host": "npm run dev:host -w @captain-whiskers/frontend",
    "dev:frontend:clean:host": "npm run dev:clean:host -w @captain-whiskers/frontend",
    "dev:backend": "npm run dev -w @captain-whiskers/backend",
    "diagnose": "bash scripts/diagnose.sh",
    "demo-recording": "bash scripts/demo-recording.sh",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "packageManager": "npm@10.2.4",
  "engines": {
    "node": ">=20"
  }
}