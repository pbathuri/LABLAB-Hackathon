{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/api/$1"
    }
  ],
  "crons": [
    {
      "path": "/agent/cron/trading-tick",
      "schedule": "0 14 * * *"
    }
  ],
  "functions": {
    "api/[[...all]].ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "dist/**"
    }
  }
}